---
import LangToggle from './LangToggle.astro';
import { ui, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const c = ui[lang];
const home = `${import.meta.env.BASE_URL}${lang}/`;
---
<header class="sticky top-0 z-10 border-b border-line bg-bg/90 backdrop-blur">
  <nav class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-5 gap-y-3 px-5 py-3">
    <a href={home} class="inline-flex shrink-0 items-center gap-2 text-lg font-bold tracking-tight">
      <img src={`${import.meta.env.BASE_URL}brand/flowsky.png`} alt="" width="800" height="480" class="h-7 w-auto rounded" /><span>FlowSky</span>
    </a>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
      <a href={`${home}#features`} class="hidden text-muted hover:text-ink md:inline">{c.nav.features}</a>
      <a href={`${home}support/`} class="text-muted hover:text-ink">{c.nav.support}</a>
      <LangToggle lang={lang} />
    </div>
  </nav>
</header>
