---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { languages, htmlLang, contact, type Lang } from '../i18n/ui';
interface Props { title: string; description: string; lang: Lang; noindex?: boolean }
const { title, description, lang, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(noindex ? `${base}en/` : Astro.url.pathname, Astro.site);
const image = new URL(`${base}brand/flowsky.png`, Astro.site);
const alternate = (target: Lang) => new URL(/\/(en|zh|ja)(\/|$)/.test(Astro.url.pathname)
  ? Astro.url.pathname.replace(/\/(en|zh|ja)(\/|$)/, `/${target}$2`) : `${base}${target}/`, Astro.site);
const schema = {
  '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonical.href, inLanguage: htmlLang[lang],
  publisher: { '@type': 'Organization', name: 'SZLab', email: contact },
  isPartOf: { '@type': 'WebSite', name: 'FlowSky for Bluesky', url: new URL(`${base}${lang}/`, Astro.site).href },
};
---
<!doctype html>
<html lang={htmlLang[lang]}>
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
  <link rel="canonical" href={canonical.href} />
  {languages.map(target => <link rel="alternate" hreflang={htmlLang[target]} href={alternate(target).href} />)}
  <link rel="alternate" hreflang="x-default" href={alternate('en').href} />
  <link rel="icon" type="image/png" href={image.href} />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0d1219" media="(prefers-color-scheme: dark)" />
  <meta property="og:type" content="website" /><meta property="og:site_name" content="FlowSky for Bluesky" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:url" content={canonical.href} /><meta property="og:locale" content={{en:'en_US',zh:'zh_CN',ja:'ja_JP'}[lang]} />
  <meta property="og:image" content={image.href} /><meta property="og:image:alt" content="FlowSky" />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} /><meta name="twitter:image" content={image.href} />
  <title>{title}</title>
  {!noindex && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}></script>}
</head>
<body class="bg-bg font-sans text-ink antialiased"><Header lang={lang} /><main><slot /></main><Footer lang={lang} /></body>
</html>
